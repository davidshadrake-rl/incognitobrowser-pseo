{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "niche",
    "slug",
    "title",
    "metaDescription",
    "keywords",
    "intro",
    "products",
    "features",
    "verdict",
    "pro_tips",
    "faqs",
    "editorial"
  ],
  "properties": {
    "niche": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "maxLength": 70,
      "description": "No year. At most 70 characters: tests/comparison-score.test.ts checks every file against this limit."
    },
    "metaDescription": {
      "type": "string",
      "maxLength": 160
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "maxItems": 6
    },
    "intro": {
      "type": "string",
      "maxLength": 300
    },
    "products": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "slug",
          "tagline",
          "platforms",
          "pros",
          "cons"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "tagline": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "pricing": {
            "type": "string"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Where the product runs, e.g. [\"Android\", \"iOS\", \"Windows\"]."
          },
          "pros": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          },
          "cons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "not": {
          "required": [
            "rating"
          ]
        },
        "description": "No rating field: every rating is worked out from the feature table by lib/comparison-score.ts, and a typed one is never read."
      }
    },
    "features": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "scores"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The criterion. Used once on the page (names are compared without regard to case or spacing). A criterion about speed, performance, latency or resource use (load time, memory, CPU, battery), by its name or its description, gets a value only in cells whose note cites a third-party lab result; see scores' note."
          },
          "description": {
            "type": "string"
          },
          "scores": {
            "type": "object",
            "description": "One cell per product, keyed by the product's slug.",
            "additionalProperties": {
              "type": "object",
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "enum": [
                    "yes",
                    "excellent",
                    "good",
                    "partial",
                    "fair",
                    "limited",
                    "poor",
                    "no",
                    "none",
                    "—",
                    "unknown",
                    "n/a"
                  ],
                  "description": "The rubric in lib/comparison-score.ts: yes/excellent 1, good 0.75, partial/fair/limited 0.5, poor 0.25, no/none 0; '—', 'unknown' and 'n/a' are not assessed and left out of the rating."
                },
                "note": {
                  "type": "string",
                  "description": "Not shown on the page. A speed or performance cell cites a third-party lab result here: the lab (AV-Comparatives, AV-TEST or SE Labs) followed by the test's name, its date or a figure, as in \"Impact score 9.6 (ADVANCED+), AV-Comparatives April 2026\". Without one the cell is '—', and the page names any lab it uses in text it shows."
                }
              }
            }
          }
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "summary",
        "bestFor"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "bestFor": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "useCase": {
                "type": "string"
              },
              "product": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "pro_tips": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 5,
      "maxItems": 5
    },
    "faqs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "editorial": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "published"
          ],
          "description": "Editorial gate. Only 'published' pages get indexed in robots meta + sitemap. Promotion requires a human reviewer."
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "author": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "bio": {
              "type": "string"
            },
            "credentials": {
              "type": "string"
            },
            "profileUrl": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      ],
      "description": "Named human author. Required when editorial.status === 'published'. Renders as JSON-LD Person + Article author."
    }
  }
}
