{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["niche", "slug", "title", "metaDescription", "description", "templateType", "sections", "useCases"],
  "properties": {
    "niche": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "maxLength": 70 },
    "metaDescription": { "type": "string", "maxLength": 160 },
    "description": { "type": "string", "maxLength": 300 },
    "templateType": { "type": "string", "enum": ["letter", "policy", "checklist", "plan", "request", "notice", "agreement"] },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "content"],
        "properties": {
          "heading": { "type": "string" },
          "content": { "type": "string" },
          "placeholders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string" },
                "label": { "type": "string" },
                "defaultValue": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "useCases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "relatedLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    }
  }
}
