# Copy this file to .secrets and fill it in. .secrets is never committed.
# scripts/deploy.sh reads it.

# The droplet and the SSH login that can write to its web folder.
DEPLOY_HOST=your.droplet.ip.address
DEPLOY_USER=root
DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# The address the sites are served from, no trailing slash.
SITE_ORIGIN=https://your-droplet-address

# Optional: where the web folders live on the droplet (default /var/www/html).
# DEPLOY_WEB_ROOT=/var/www/html
