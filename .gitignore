/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

playwright-report/
test-results/
deployment-status.md
*.pdf
out*/

# Droplet login for scripts/deploy.sh. Never commit.
.secrets

# Observed run-to-run state for the RASP checks: last restart count, last
# evicted-key count, last canary timings. It changes on every run by design.
# The EXPECTATIONS it is graded against live in rasp-baseline.json, which IS
# committed — keeping the two apart is what stops a nightly run quietly
# rewriting the thing it is supposed to be failing against.
scripts/security/data/rasp-runtime-state.json

# Security suite reports: machine-generated, name live hosts and findings.
reports/
